# Токен бота от @BotFather (обязателен для бота; без него процесс
# стартует в режиме «только API»).
BOT_TOKEN=

# Прокси для доступа к api.telegram.org (http://… или socks5://…),
# если API недоступен из сети напрямую. Приоритетнее пиннинга IP.
PROXY_URL=

# Пиннинг официального IP для api.telegram.org на случай, когда
# локальный DNS отдаёт недоступный адрес (можно список через запятую).
TELEGRAM_API_IP=149.154.167.220

# Публичный HTTPS-адрес сервера: по нему Telegram открывает Mini App.
# Управляется scripts/tunnel_keepalive.sh (автопереключение туннеля).
BASE_URL=http://localhost:8000

# Адрес и порт, на которых слушать входящие соединения.
HOST=0.0.0.0
PORT=8000

# База данных SQLite (по умолчанию — файл pokerbot.db в корне проекта).
# DATABASE_URL=sqlite+aiosqlite:///./pokerbot.db

# Дев-режим: 1 = доступен вход тестовым игроком без Telegram
# (POST /api/auth/dev, удобно для верстки в браузере). В проде держать 0!
DEV_MODE=0
